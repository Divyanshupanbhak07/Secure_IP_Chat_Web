# Application Environment Configuration

# Node Environment (development | production | test)
NODE_ENV=development

# Backend Server Configuration
PORT=5000
HOST=0.0.0.0
TRUST_PROXY=true

# Frontend URL (for CORS validation)
FRONTEND_URL=http://localhost:5173

# Redis Configuration (leave empty or default for local in-memory fallback mode)
REDIS_URL=redis://127.0.0.1:6379
REDIS_PASSWORD=

# Session & Security Controls
SESSION_SECRET=change-this-to-a-cryptographically-secure-random-secret-key-32-chars
ROOM_TTL_DEFAULT_SECONDS=1800
MAX_PARTICIPANTS_PER_ROOM=5
MESSAGE_MAX_LENGTH=2000

# Rate Limiting Controls
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_ROOM_CREATION=5
RATE_LIMIT_MAX_JOIN_ATTEMPTS=20
RATE_LIMIT_MAX_MESSAGES_PER_MIN=30
